# pnpm configuration for this project

# Enable hoisting to avoid import resolution issues with ESLint and TypeScript
# This makes dependencies more accessible similar to npm's flat structure
public-hoist-pattern[]=*eslint*
public-hoist-pattern[]=*typescript*
public-hoist-pattern[]=@typescript-eslint/*
public-hoist-pattern[]=vite
public-hoist-pattern[]=@vitejs/*

# Auto-install peer dependencies
auto-install-peers=true

# Strict peer dependencies - set to false for more lenient resolution
strict-peer-dependencies=false

# Dedupe peer dependents for smaller node_modules
dedupe-peer-dependents=true

# If you still experience issues, you can uncomment the line below
# This hoists ALL dependencies to root (not recommended for production but fixes most issues)
# shamefully-hoist=true
